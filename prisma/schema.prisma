// EduConnect AI – database schema (PostgreSQL). pgvector is NOT required:
// embeddings are stored as Float[] and ranked with cosine similarity in the app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum InstitutionType {
  SCHOOL
  COLLEGE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ExamType {
  INTERNAL
  FINAL
}

enum MaterialType {
  NOTES
  SUBJECT_MATERIAL
  PRESENTATION
  DOCUMENT
  QUESTION_PAPER
  VIDEO
}

enum ComplaintCategory {
  ACADEMIC
  ATTENDANCE
  EXAMINATION
  FEE
  LIBRARY
  HOSTEL
  TECHNICAL
  OTHER
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT
  MESSAGE
  MATERIAL
  EXAM
  RESULT
  ATTENDANCE
  COMPLAINT
  ANNOUNCEMENT
  SYSTEM
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum AIRole {
  USER
  ASSISTANT
}

enum AIKind {
  CHAT
  PDF
}

model Institution {
  id        String          @id @default(uuid())
  name      String
  code      String          @unique
  type      InstitutionType @default(COLLEGE)
  address   String?
  email     String?
  phone     String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  users         User[]
  memberships   Membership[]
  students      StudentProfile[]
  teachers      TeacherProfile[]
  admins        AdminProfile[]
  academicYears AcademicYear[]
  departments   Department[]
  programs      Program[]
  gradeLevels   GradeLevel[]
  classSections ClassSection[]
  subjects      Subject[]
  courses       Course[]
  enrollments   Enrollment[]
  teachingAssignments TeachingAssignment[]
  attendanceSessions  AttendanceSession[]
  assignments   Assignment[]
  examinations  Examination[]
  materials     StudyMaterial[]
  conversations Conversation[]
  complaints    Complaint[]
  notifications Notification[]
  announcements Announcement[]
  documents     Document[]
  chunks        DocumentChunk[]
  aiConversations AIConversation[]
  auditLogs     AuditLog[]
}

model User {
  id            String       @id @default(uuid())
  institutionId String?
  role          Role
  loginId       String       @unique // student ID / employee ID / admin ID
  email         String       @unique
  name          String
  passwordHash  String
  isActive      Boolean      @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  memberships Membership[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  adminProfile   AdminProfile?
  sentMessages   Message[]
  notifications  Notification[]
  studentConversations Conversation[] @relation("ConvStudent")
  teacherConversations Conversation[] @relation("ConvTeacher")
  complaints     Complaint[] @relation("ComplaintStudent")
  assignedComplaints Complaint[] @relation("ComplaintAdmin")
  materials      StudyMaterial[]
  announcements  Announcement[]
  documents      Document[]
  aiConversations AIConversation[]
  auditLogs      AuditLog[]

  @@index([institutionId, role])
}

model Membership {
  id            String   @id @default(uuid())
  userId        String
  institutionId String
  role          Role
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId])
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  institutionId  String
  classSectionId String?
  programId      String?
  rollNo         String?
  semester       Int?
  guardianName   String?
  phone          String?
  feeTotal       Int      @default(0)
  feePaid        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions  AssignmentSubmission[]
  results      StudentResult[]

  @@index([institutionId])
  @@index([classSectionId])
}

model TeacherProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  institutionId String
  departmentId  String?
  designation   String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teachingAssignments TeachingAssignment[]
  attendanceSessions  AttendanceSession[]
  assignments Assignment[]

  @@index([institutionId])
}

model AdminProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  institutionId String?
  title         String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
}

model AcademicYear {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@index([institutionId])
}

model Department {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  code          String?
  createdAt     DateTime @default(now())

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs    Program[]
  teachers    TeacherProfile[]
  subjects    Subject[]

  @@unique([institutionId, name])
}

model Program {
  id            String   @id @default(uuid())
  institutionId String
  departmentId  String?
  name          String
  durationYears Int      @default(3)
  createdAt     DateTime @default(now())

  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classSections ClassSection[]
  students      StudentProfile[]

  @@unique([institutionId, name])
}

model GradeLevel {
  id            String   @id @default(uuid())
  institutionId String
  name          String // e.g. "Class 10"
  sortOrder     Int      @default(0)

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@unique([institutionId, name])
}

model ClassSection {
  id             String   @id @default(uuid())
  institutionId  String
  academicYearId String?
  gradeLevelId   String?
  programId      String?
  name           String // display name e.g. "Class 10-A" or "BCA Sem 3"
  createdAt      DateTime @default(now())

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  gradeLevel   GradeLevel?   @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  students     StudentProfile[]
  courses      Course[]

  @@unique([institutionId, name])
}

model Subject {
  id            String   @id @default(uuid())
  institutionId String
  departmentId  String?
  name          String
  code          String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courses     Course[]

  @@unique([institutionId, name])
}

// A Course = a Subject offered to a ClassSection (the unit teachers teach and students enroll in).
model Course {
  id             String   @id @default(uuid())
  institutionId  String
  subjectId      String
  classSectionId String
  semester       Int?
  createdAt      DateTime @default(now())

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  teachingAssignments TeachingAssignment[]
  attendanceSessions  AttendanceSession[]
  assignments  Assignment[]
  examinations Examination[]
  materials    StudyMaterial[]
  conversations Conversation[]

  @@unique([subjectId, classSectionId])
  @@index([institutionId])
}

model Enrollment {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  courseId      String
  createdAt     DateTime @default(now())

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

model TeachingAssignment {
  id            String   @id @default(uuid())
  institutionId String
  teacherId     String
  courseId      String
  createdAt     DateTime @default(now())

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([teacherId, courseId])
  @@index([courseId])
}

model AttendanceSession {
  id            String   @id @default(uuid())
  institutionId String
  courseId      String
  teacherId     String
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]

  @@unique([courseId, date])
  @@index([institutionId, date])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Assignment {
  id            String   @id @default(uuid())
  institutionId String
  courseId      String
  teacherId     String
  title         String
  description   String
  dueDate       DateTime
  maxMarks      Int      @default(10)
  createdAt     DateTime @default(now())

  institution Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId, dueDate])
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  studentId    String
  content      String?
  filePath     String?
  fileName     String?
  marks        Int?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Examination {
  id            String    @id @default(uuid())
  institutionId String
  courseId      String
  title         String
  type          ExamType  @default(INTERNAL)
  date          DateTime
  maxMarks      Int       @default(100)
  passMarks     Int       @default(35)
  resultsPublished Boolean @default(false)
  createdAt     DateTime  @default(now())

  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  results     StudentResult[]

  @@index([institutionId, date])
}

model StudentResult {
  id            String   @id @default(uuid())
  examinationId String
  studentId     String
  marks         Float
  grade         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examination Examination    @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId])
  @@index([studentId])
}

model StudyMaterial {
  id            String       @id @default(uuid())
  institutionId String
  courseId      String?
  uploadedById  String
  title         String
  description   String?
  type          MaterialType @default(NOTES)
  filePath      String?
  fileName      String?
  videoUrl      String?
  createdAt     DateTime     @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  uploadedBy  User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([institutionId, courseId])
}

model Conversation {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String // User.id
  teacherId     String // User.id
  courseId      String?
  subject       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     User        @relation("ConvStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User        @relation("ConvTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([studentId])
  @@index([teacherId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  filePath       String?
  fileName       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Complaint {
  id              String            @id @default(uuid())
  ticket          String            @unique // human-friendly ID, e.g. CMP-2026-0001
  institutionId   String
  studentId       String // User.id
  title           String
  description     String
  category        ComplaintCategory @default(OTHER)
  status          ComplaintStatus   @default(PENDING)
  assignedAdminId String?
  response        String?
  history         Json              @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       User        @relation("ComplaintStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignedAdmin User?       @relation("ComplaintAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([institutionId, status])
  @@index([studentId])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  institutionId String?
  type          NotificationType @default(SYSTEM)
  title         String
  body          String
  link          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Announcement {
  id            String   @id @default(uuid())
  institutionId String
  authorId      String
  title         String
  body          String
  audience      String   @default("ALL") // ALL | STUDENT | TEACHER | class section id
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([institutionId, createdAt])
}

model Document {
  id            String         @id @default(uuid())
  institutionId String
  ownerId       String
  title         String
  fileName      String
  filePath      String
  sizeBytes     Int
  pageCount     Int            @default(0)
  status        DocumentStatus @default(PROCESSING)
  error         String?
  hasEmbeddings Boolean        @default(false)
  createdAt     DateTime       @default(now())

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]
  aiConversations AIConversation[]

  @@index([ownerId])
}

model DocumentChunk {
  id            String  @id @default(uuid())
  documentId    String
  institutionId String
  ownerId       String
  page          Int
  chunkIndex    Int
  content       String
  embedding     Float[]

  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([documentId, page])
  @@index([ownerId])
}

model AIConversation {
  id            String   @id @default(uuid())
  userId        String
  institutionId String?
  documentId    String?
  kind          AIKind   @default(CHAT)
  title         String   @default("New conversation")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  document    Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId, kind, updatedAt])
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           AIRole
  content        String
  meta           Json? // { followUps: string[], sources: {page:number, snippet:string}[] }
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  institutionId String?
  userId        String?
  action        String
  entity        String?
  entityId      String?
  meta          Json?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
}
